<Window x:Class="DevChat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevChat" Height="760" Width="1320" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0}" FontFamily="Segoe UI" FontSize="16"
        Icon="/Resources/DevChat.ico">
    <Window.Resources>
        <!-- глифы IcoGpt/IcoDs подключены из BrandIcons.xaml -->
    </Window.Resources>
    <DockPanel>
        <!-- ═══ Шапка ═══ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" Padding="14,8" BorderBrush="{StaticResource Bd}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="/Resources/logo.png" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="DevChat" Foreground="{StaticResource Tx}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource Bg2}" CornerRadius="7" Padding="10,5" BorderBrush="{StaticResource Bd}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Tx2}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Порядок: диагностика → обновление → агенты → настройки → информация -->
                    <Button Command="{Binding DiagnoseCommand}" ToolTip="Диагностика моста" Padding="5,4">
                        <Image Source="/Resources/check.png" Width="24" Height="24"/>
                    </Button>
                    <Button Command="{Binding ReloadExtensionCommand}" ToolTip="Обновить подключение расширения" Padding="5,4" Margin="4,0,0,0">
                        <Image Source="/Resources/connection.png" Width="24" Height="24"/>
                    </Button>
                    <Button Command="{Binding InstallExtensionCommand}" ToolTip="Установить расширение в Chrome" Padding="5,4" Margin="4,0,0,0">
                        <Image Source="/Resources/connection.png" Width="24" Height="24" Opacity="0.6"/>
                    </Button>
                    <Button Command="{Binding OpenAgentsCommand}" ToolTip="Агенты: состав команды, правила, права" Padding="5,4" Margin="4,0,0,0">
                        <Image Source="/Resources/bots.png" Width="24" Height="24"/>
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}" ToolTip="Настройки проекта" Padding="5,4" Margin="4,0,0,0">
                        <Image Source="/Resources/settings.png" Width="24" Height="24"/>
                    </Button>
                    <Button Click="Help_Click" ToolTip="Инструкция по использованию" Padding="5,4" Margin="4,0,0,0">
                        <Image Source="/Resources/info.png" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Левая панель: чаты ═══ -->
        <Border DockPanel.Dock="Left" Width="248" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Bd}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10">
                <Button DockPanel.Dock="Top" Content="＋  Новый чат" Command="{Binding NewChatCommand}" Style="{StaticResource BtnAccent}" Margin="0,0,0,4" FontSize="16"/>
                <Button DockPanel.Dock="Top" Content="🔄  Новая сессия" Command="{Binding NewSessionCommand}" Margin="0,4,0,10" FontSize="16"/>
                <ListBox ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,2">
                                <Button Content="✕" FontSize="12" Width="24" Height="24" Padding="0" DockPanel.Dock="Right" VerticalAlignment="Center"
                                        Command="{Binding DataContext.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="Удалить чат"/>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="6,7,8,7" ToolTip="{Binding Title}" VerticalAlignment="Center" FontSize="16"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══ Правая панель: план / файлы (сворачивается) ═══ -->
        <Border x:Name="SidePanel" DockPanel.Dock="Right" Width="340" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Bd}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Button x:Name="SideToggle" DockPanel.Dock="Top" Content="⟩" Click="SideToggle_Click" Width="28" Height="28" Padding="0"
                        HorizontalAlignment="Right" Margin="0,8,8,0" ToolTip="Свернуть/развернуть панель" FontSize="16"/>
                <Grid x:Name="SideContent" Margin="10,10,10,10">
                    <TabControl Background="Transparent" BorderThickness="0" x:Name="SideTabs">
                        <TabItem Header="{Binding PlanHeader}">
                            <ListBox ItemsSource="{Binding PlanItems}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Mark}" Foreground="#4cc38a" FontSize="16" FontWeight="Bold" Margin="0,0,7,0" VerticalAlignment="Top"/>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource Tx}" FontSize="16" Width="260" LineHeight="22"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FilesNote}" Foreground="#6f9b6f" FontSize="14" Margin="20,3,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="Файлы">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,6">
                                    <Button Content="⟳ Обновить" Command="{Binding RefreshFilesCommand}" Padding="8,3" FontSize="16"/>
                                    <Button Content="↩ Откат" Command="{Binding UndoChatCommand}" Padding="8,3" Margin="6,0,0,0" FontSize="16"
                                            ToolTip="Вернуть файлы к виду до записей этого чата (журнал оригиналов)"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Files}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource Tx2}" FontFamily="Consolas" FontSize="16" Margin="4,2" ToolTip="{Binding}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═══ Композер (ввод) ═══ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Bd}" BorderThickness="0,1,0,0" Padding="14,10">
            <Border Background="{StaticResource Bg0}" CornerRadius="12" BorderBrush="{StaticResource Bd}" BorderThickness="1" Padding="10">
                <DockPanel>
                    <!-- справа: отправка/стоп/таймер -->
                    <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Bottom">
                        <Button x:Name="SendRound" Content="➤" Command="{Binding SendCommand}" Style="{StaticResource BtnAccent}" Width="44" Height="44" Padding="0" FontSize="16"/>
                        <Button Content="■" Command="{Binding StopCommand}" Style="{StaticResource BtnDanger}" Width="44" Height="28" Padding="0" Margin="0,6,0,0" FontSize="12"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <!-- сверху: чипы режимов -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,7">
                        <Button Content="{Binding WorkModeLabel}" Command="{Binding CycleWorkModeCommand}" Style="{StaticResource BtnChip}" ToolTip="Режим работы"/>
                        <Button Command="{Binding CycleProviderCommand}" Style="{StaticResource BtnChip}" Margin="6,0,0,0" ToolTip="Провайдер ИИ">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource IcoGpt}" VerticalAlignment="Center" Visibility="{Binding HasGptIcon, Converter={StaticResource BoolToVis}}"/>
                                <ContentControl ContentTemplate="{StaticResource IcoDs}" VerticalAlignment="Center" Visibility="{Binding HasDsIcon, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding ProviderName2}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="{Binding ConfirmModeLabel}" Command="{Binding CycleConfirmModeCommand}" Style="{StaticResource BtnChip}" Margin="6,0,0,0" ToolTip="Подтверждения"/>
                        <TextBlock Text="{Binding BusyInfoText}" Foreground="{StaticResource Warn}" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBox x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="170" FontSize="16"
                             Background="{StaticResource Bg1}" BorderThickness="1" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputBox_PreviewKeyDown"/>
                </DockPanel>
            </Border>
        </Border>

        <!-- ═══ Лента сообщений ═══ -->
        <ListBox x:Name="MessagesList" ItemsSource="{Binding Messages}" HorizontalContentAlignment="Stretch" Padding="10,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,3">
                        <!-- карточка действия агента -->
                        <Border x:Name="agentCard" CornerRadius="9" Padding="12,8" Margin="1" Background="#B31d1f26"
                                BorderBrush="{StaticResource Bd}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Tx3}" FontSize="14"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Text}" Foreground="#9ec3e8" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Border>
                        <!-- пузырь сообщения -->
                        <Border x:Name="bubble" CornerRadius="10" Padding="14,10" Margin="1"
                                Background="#B3232630" BorderBrush="{StaticResource Bd}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Tx3}" FontSize="14" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                                        <Button Content="⧉" FontSize="14" Width="28" Height="24" Padding="0"
                                                Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" ToolTip="Скопировать"/>
                                        <Button Content="↺" FontSize="14" Width="28" Height="24" Padding="0" Margin="2,0,0,0"
                                                Command="{Binding DataContext.RepeatMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" ToolTip="Вернуть в поле ввода"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16" LineHeight="23" Foreground="{StaticResource Tx}"/>
                            </StackPanel>
                        </Border>
                        <!-- системная строка -->
                        <Border x:Name="sysRow" Visibility="Collapsed" HorizontalAlignment="Center" Padding="4">
                            <TextBlock Text="{Binding Text}" Foreground="{StaticResource Tx3}" FontSize="16" TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="640"/>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Role}" Value="user">
                            <Setter TargetName="bubble" Property="Background" Value="#B339406b"/>
                            <Setter TargetName="bubble" Property="BorderBrush" Value="#66434b78"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Role}" Value="system">
                            <Setter TargetName="bubble" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="sysRow" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Role}" Value="agent">
                            <Setter TargetName="bubble" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="agentCard" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>

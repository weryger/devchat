<Window x:Class="DevChat.App.AgentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🤖 Агенты" Width="880" Height="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg0}" FontFamily="Segoe UI">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Tx}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,2"
                   Text="Агенты команды (скиллы)"/>
        <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Tx3}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Каждый агент — файл-скилл: роль в команде (role), права (tools), правила и формат вывода. Галочка «в команде» включает агента в состав бригады; выключенные тимлид не видит."/>

        <!-- тулбар -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="＋ Новый агент" Style="{StaticResource BtnAccent}" Click="New_Click"/>
            <Button Content="📂 Импорт .md" Margin="8,0,0,0" Click="Import_Click" ToolTip="Загрузить готовый файл скилла"/>
            <Button Content="💾 Сохранить" Margin="8,0,0,0" Click="Save_Click"/>
            <Button Content="🗑 Удалить" Style="{StaticResource BtnDanger}" Margin="8,0,0,0" Click="Delete_Click"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- список агентов -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}" CornerRadius="9" BorderBrush="{StaticResource Bd}" BorderThickness="1" Padding="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Состав" Foreground="{StaticResource Tx3}" FontSize="11" Margin="8,6,0,6"/>
                    <ListBox x:Name="AgentsList" SelectionChanged="AgentsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Ok}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource Tx3}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Tx}" FontSize="12.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RoleNote}" Foreground="{StaticResource Tx3}" FontSize="10.5" Margin="14,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- редактор -->
            <Border Grid.Column="2" Background="{StaticResource Bg1}" CornerRadius="9" BorderBrush="{StaticResource Bd}" BorderThickness="1" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя" Foreground="{StaticResource Tx3}" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Grid.Row="1" Grid.Column="0" x:Name="NameBox"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Роль (role, ключ)" Foreground="{StaticResource Tx3}" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="RoleBox"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Права (full/readonly/run)" Foreground="{StaticResource Tx3}" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Grid.Row="1" Grid.Column="4" x:Name="ToolsBox"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание" Foreground="{StaticResource Tx3}" FontSize="11" Margin="0,8,0,3"/>
                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" x:Name="DescBox"/>
                    </Grid>

                    <CheckBox x:Name="EnabledCheck" DockPanel.Dock="Top" Margin="0,10,0,8" Content="В составе команды (тимлид назначает этому агенту пункты плана)"/>

                    <TextBlock DockPanel.Dock="Top" Text="Правила и формат вывода (markdown)" Foreground="{StaticResource Tx3}" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="BodyBox" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" BorderThickness="1"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>

<Window x:Class="DevChat.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#25262e">
    <StackPanel Margin="16">
        <TextBlock Text="Порт моста" Foreground="#b9bbc6" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Port}" />

        <TextBlock Text="Токен (вводится в расширении: src/extension/src/config.ts)" Foreground="#b9bbc6" Margin="0,12,0,4"/>
        <TextBox Text="{Binding Token}" />

        <TextBlock Text="Рабочая папка проектов (для агентного режима, M2)" Foreground="#b9bbc6" Margin="0,12,0,4"/>
        <TextBox Text="{Binding WorkingFolder}" />

        <CheckBox x:Name="PreventSleepCheck" Content="Не давать ПК спать, пока приложение запущено (для ночных задач)"
                  Foreground="#d6d8e0" Margin="0,14,0,0"/>

        <TextBlock Text="Изменение порта применяется после перезапуска приложения."
                   Foreground="#7a7c88" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сохранить" Click="Save_Click"/>
            <Button Content="Отмена" Background="#3a3d4a" Margin="8,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="DevChat.App.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение действия" Width="720" Height="520" WindowStartupLocation="CenterOwner"
        Background="#25262e">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Header}" Foreground="#e8e8ec" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding SubHeader}" Foreground="#b9bbc6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <CheckBox x:Name="AllowRestCheck" Content="Разрешить остальные действия этой задачи без вопросов"
                      Foreground="#b9bbc6" Margin="0,0,0,10" IsChecked="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Разрешить" Background="#3f8f5f" Click="Allow_Click" Width="110"/>
                <Button Content="Отклонить" Background="#8f3f3f" Margin="8,0,0,0" Click="Deny_Click" Width="110"/>
            </StackPanel>
        </StackPanel>
        <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Height="330"/>
    </DockPanel>
</Window>
